{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.tools/Qt/6.8.3/msvc2022_64"
      }
    },
    {
      "name": "vs2026",
      "inherits": "base",
      "displayName": "MSVC 2026 (x64), Debug + Release",
      "description": "Multi-config Visual Studio 18 2026 tree under build/vs2026.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2022",
      "inherits": "base",
      "displayName": "MSVC 2022 (x64), Debug + Release",
      "description": "Multi-config Visual Studio 17 2022 tree under build/vs2022.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2026-tidy",
      "inherits": "vs2026",
      "displayName": "MSVC 2026 (x64) with clang-tidy",
      "description": "Same as vs2026 but runs clang-tidy; findings do not fail the build.",
      "binaryDir": "${sourceDir}/build/vs2026-tidy",
      "cacheVariables": {
        "DRUMAS_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "vs2022-tidy",
      "inherits": "vs2022",
      "displayName": "MSVC 2022 (x64) with clang-tidy",
      "description": "Same as vs2022 but runs clang-tidy; findings do not fail the build.",
      "binaryDir": "${sourceDir}/build/vs2022-tidy",
      "cacheVariables": {
        "DRUMAS_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2026-tidy-debug",
      "configurePreset": "vs2026-tidy",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-tidy-debug",
      "configurePreset": "vs2022-tidy",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
